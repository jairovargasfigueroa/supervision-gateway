# Copiar a .env. Valores de desarrollo: docs/entorno-local.md de supervision-docs.
PORT=4000
# development (por defecto) o production: en production, registros en JSON, sin introspección ni Sandbox (601)
NODE_ENV=development
# Direcciones obligatorias (601: sin valor por defecto en el código); en la nube, las públicas con https://
OBRAS_URL=http://localhost:8081
MATERIALES_URL=http://localhost:8082
FINANZAS_URL=http://localhost:8083
# Servicio de IA (capa 4: 402, 403; capa 5: 503, 502)
IA_URL=http://localhost:8085
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=supervision
KEYCLOAK_GATEWAY_CLIENT_ID=gateway
# Secreto fijo solo para desarrollo (realm de infra)
KEYCLOAK_GATEWAY_CLIENT_SECRET=gateway-secreto-solo-desarrollo
# Orígenes del ERP separados por coma (nunca "*"); en la nube, el del shell publicado
CORS_ORIGENES=http://localhost:4200,http://localhost:4201,http://localhost:4202,http://localhost:4203
# Opcional (ensayo local de la 601): ruta de una CA adicional para llamar a los servicios y a Keycloak por HTTPS
# NODE_EXTRA_CA_CERTS=/certificados/ca.crt
